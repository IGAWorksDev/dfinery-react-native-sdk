{
  "name": "dfinery-react-native-sdk-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "react-native spm add --yes",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "cd android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "cd ios && xcodebuild -scheme DfineryReactNativeSdkExample -configuration Debug -sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO",
    "clean": "./scripts/clean-ios.sh"
  },
  "dependencies": {
    "@igaworks/dfinery-react-native-sdk": "file:../sdk",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-permissions": "^5.4.1",
    "react-native-tracking-transparency": "^0.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/react": "^19.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
